index aea55e0..003dd6f 100644
--- a/tools/autojev/autojev-common.cpp
+++ b/tools/autojev/autojev-common.cpp
@@ -238,0 +239,13 @@ std::string build_user_prompt(const json & state, const json & question,
+std::string describe_state(const json & state) { return describe(state); }
+
+std::string build_options_prefix(const json & question, const std::vector<std::string> & codes, const option_set & options) {
+    const json instructions = question.value("instructions", json());
+    std::string result = "Question:\n" + describe(is_falsey(instructions) ? json("Choose the best matching option.") : instructions);
+    result += "\n\nOptions:\n";
+    for (size_t i = 0; i < options.keys.size(); ++i) {
+        if (i != 0) result += '\n';
+        result += codes[i] + ": " + describe(options.descriptions[i]);
+    }
+    return result + "\n\nState:\n";
+}
+
